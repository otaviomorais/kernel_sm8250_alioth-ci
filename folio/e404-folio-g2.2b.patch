+/*
+ * Folio variants of the classic-LRU helpers above.
+ *
+ * Two E404/MGLRU specific decisions:
+ *
+ * 1. The explicit `enum lru_list lru` argument is kept instead of
+ *    recomputing it with folio_lru_list().  E404 still has callers that
+ *    operate on a non-head page (the THP split path in lru_add_page_tail()
+ *    links through page_tail), and those need an explicit page-level path.
+ *
+ * 2. Each helper defers to lru_gen_add_page()/lru_gen_del_page() first,
+ *    exactly like __lru_add_page3() and __lru_del_page3() do.  A classic
+ *    insertion and an MGLRU insertion must never both own folio->lru and
+ *    the same accounting transition, otherwise the LRU counters drift.
+ */
+static __always_inline void lruvec_add_folio(struct lruvec *lruvec,
+				struct folio *folio, enum lru_list lru)
+{
+	if (lru_gen_add_page(lruvec, &folio->page, false))
+		return;
+
+	update_lru_size(lruvec, lru, folio_zonenum(folio),
+			folio_nr_pages(folio));
+	list_add(&folio->lru, &lruvec->lists[lru]);
+}
+
+static __always_inline void lruvec_add_folio_tail(struct lruvec *lruvec,
+				struct folio *folio, enum lru_list lru)
+{
+	if (lru_gen_add_page(lruvec, &folio->page, true))
+		return;
+
+	update_lru_size(lruvec, lru, folio_zonenum(folio),
+			folio_nr_pages(folio));
+	list_add_tail(&folio->lru, &lruvec->lists[lru]);
+}
+
+static __always_inline void lruvec_del_folio(struct lruvec *lruvec,
+				struct folio *folio, enum lru_list lru)
+{
+	if (lru_gen_del_page(lruvec, &folio->page, false))
+		return;
+
+	list_del(&folio->lru);
+	update_lru_size(lruvec, lru, folio_zonenum(folio),
+			-folio_nr_pages(folio));
+}
+
 #endif
