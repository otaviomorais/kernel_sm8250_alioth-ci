 		}
-		VM_BUG_ON_PAGE(page->index != offset, page);
+		VM_BUG_ON_FOLIO(folio->index != index, folio);
 	}
 
-	if (page && (fgp_flags & FGP_ACCESSED))
-		mark_page_accessed(page);
+	if (folio && (fgp_flags & FGP_ACCESSED))
+		folio_mark_accessed(folio);
 
 no_page:
-	if (!page && (fgp_flags & FGP_CREAT)) {
+	if (!folio && (fgp_flags & FGP_CREAT)) {
 		int err;
 		if ((fgp_flags & FGP_WRITE) && mapping_cap_account_dirty(mapping))
-			gfp_mask |= __GFP_WRITE;
+			gfp |= __GFP_WRITE;
 		if (fgp_flags & FGP_NOFS)
-			gfp_mask &= ~__GFP_FS;
+			gfp &= ~__GFP_FS;
 
-		page = __page_cache_alloc(gfp_mask);
-		if (!page)
+		folio = filemap_alloc_folio(gfp, 0);
+		if (!folio)
 			return NULL;
 
 		if (WARN_ON_ONCE(!(fgp_flags & (FGP_LOCK | FGP_FOR_MMAP))))
 			fgp_flags |= FGP_LOCK;
 
-		/* Init accessed so avoid atomic mark_page_accessed later */
+		/* Init accessed so avoid atomic folio_mark_accessed later */
 		if (fgp_flags & FGP_ACCESSED)
-			__SetPageReferenced(page);
+			__folio_set_referenced(folio);
 
-		err = add_to_page_cache_lru(page, mapping, offset, gfp_mask);
+		err = filemap_add_folio(mapping, folio, index, gfp);
 		if (unlikely(err)) {
-			put_page(page);
-			page = NULL;
+			folio_put(folio);
+			folio = NULL;
 			if (err == -EEXIST)
 				goto repeat;
 		}
 
 		/*
-		 * add_to_page_cache_lru locks the page, and for mmap we expect
+		 * filemap_add_folio locks the page, and for mmap we expect
 		 * an unlocked page.
 		 */
-		if (page && (fgp_flags & FGP_FOR_MMAP))
-			unlock_page(page);
+		if (folio && (fgp_flags & FGP_FOR_MMAP))
+			folio_unlock(folio);
 	}
 
-	return page;
+	return folio;
+}
+EXPORT_SYMBOL(__filemap_get_folio);
+
+/*
+ * pagecache_get_page - Find and get a reference to a page.
+ *
+ * This is the compatibility wrapper upstream puts in mm/folio-compat.c, which
+ * this tree does not have.  It stays a real function, not a static inline,
+ * because pagecache_get_page is listed in android/abi_gki_aarch64_qcom: the
+ * vendor GKI ABI promises the symbol, so it has to keep existing and keep
+ * being exported.
+ *
+ * Upstream's wrapper consults FGP_HEAD and falls back to folio_file_page().
+ * E404 has neither the flag nor the multi-page xarray entries those handle,
+ * so the head page is always the right answer here.
+ */
+struct page *pagecache_get_page(struct address_space *mapping, pgoff_t offset,
+		int fgp_flags, gfp_t cache_gfp_mask)
+{
+	struct folio *folio = __filemap_get_folio(mapping, offset, fgp_flags,
+						 cache_gfp_mask);
+
+	return folio ? &folio->page : NULL;
 }
 EXPORT_SYMBOL(pagecache_get_page);
 
