diff --git a/mm/swap.c b/mm/swap.c
index 60eeb49..9835c0f 100644
--- a/mm/swap.c
+++ b/mm/swap.c
@@ -499,19 +499,39 @@ void lru_cache_add_file(struct page *page)
 EXPORT_SYMBOL(lru_cache_add_file);
 
 /**
- * lru_cache_add - add a page to a page list
- * @page: the page to be added to the LRU.
+ * folio_add_lru - Add a folio to an LRU list.
+ * @folio: The folio to be added to the LRU.
  *
- * Queue the page for addition to the LRU via pagevec. The decision on whether
- * to add the page to the [in]active [file|anon] list is deferred until the
- * pagevec is drained. This gives a chance for the caller of lru_cache_add()
- * have the page added to the active list using mark_page_accessed().
+ * Queue the folio for addition to the LRU. The decision on whether
+ * to add the folio to the [in]active [file|anon] list is deferred until the
+ * pagevec is drained. This gives a chance for the caller of folio_add_lru()
+ * to have the folio added to the active list using folio_mark_accessed().
+ */
+void folio_add_lru(struct folio *folio)
+{
+	VM_BUG_ON_FOLIO(folio_test_active(folio) && folio_test_unevictable(folio),
+			folio);
+	VM_BUG_ON_FOLIO(folio_test_lru(folio), folio);
+
+	/*
+	 * Upstream inlines the body here using pagevec_add_and_need_flush(),
+	 * which does not exist in the E404 4.19 base.  MGLRU already split
+	 * lru_cache_add() into this same shape: __lru_cache_add() below holds
+	 * the body and lru_cache_add() is the entry point, so the folio
+	 * version reuses that body verbatim, with the head page.
+	 */
+	__lru_cache_add(&folio->page);
+}
+EXPORT_SYMBOL(folio_add_lru);
+
+/*
+ * Compatibility wrapper for callers not yet converted to folios.  Upstream
+ * puts this in mm/folio-compat.c, which this tree does not have.  Note the
+ * E404 lru_cache_add() is not exported today, so neither is this.
  */
 void lru_cache_add(struct page *page)
 {
-	VM_BUG_ON_PAGE(PageActive(page) && PageUnevictable(page), page);
-	VM_BUG_ON_PAGE(PageLRU(page), page);
-	__lru_cache_add(page);
+	folio_add_lru(page_folio(page));
 }
 
