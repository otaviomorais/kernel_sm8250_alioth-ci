+/*
+ * Return the page whose flags carry a folio flag.  E404 stores the
+ * DoubleMap bit in the first tail page; no other page flag needs an
+ * offset other than zero.
+ */
+static inline unsigned long *folio_flags(struct folio *folio, unsigned int n)
+{
+	struct page *page = &folio->page;
+
+	VM_BUG_ON_PGFLAGS(PageTail(page), page);
+	VM_BUG_ON_PGFLAGS(n > 0 && !test_bit(PG_head, &page->flags), page);
+	return &page[n].flags;
+}
