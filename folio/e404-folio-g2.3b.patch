+/*
+ * Folio counterparts of the waiters above.  The caller must be "holding"
+ * the folio (ie with an increased refcount) so it cannot go away.
+ */
+static inline __sched void folio_wait_locked(struct folio *folio)
+{
+	if (folio_test_locked(folio))
+		wait_on_page_bit(&folio->page, PG_locked);
+}
+
+static inline __sched int folio_wait_locked_killable(struct folio *folio)
+{
+	if (!folio_test_locked(folio))
+		return 0;
+	return wait_on_page_bit_killable(&folio->page, PG_locked);
+}
