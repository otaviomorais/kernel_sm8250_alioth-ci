+/*
+ * Folio counterpart of __lock_page_or_retry().  See the comment above
+ * __lock_page_or_retry() for the return value and mmap_sem implications.
+ */
+bool __sched __folio_lock_or_retry(struct folio *folio, struct mm_struct *mm,
+				  unsigned int flags)
+{
+	if (fault_flag_allow_retry_first(flags)) {
+		/*
+		 * CAUTION! In this case, mmap_sem is not released
+		 * even though return 0.
+		 */
+		if (flags & FAULT_FLAG_RETRY_NOWAIT)
+			return false;
+
+		up_read(&mm->mmap_sem);
+		if (flags & FAULT_FLAG_KILLABLE)
+			folio_wait_locked_killable(folio);
+		else
+			folio_wait_locked(folio);
+		return false;
+	} else {
+		if (flags & FAULT_FLAG_KILLABLE) {
+			int ret;
+
+			ret = __folio_lock_killable(folio);
+			if (ret) {
+				up_read(&mm->mmap_sem);
+				return false;
+			}
+		} else
+			__folio_lock(folio);
+	}
+	return true;
+}
+
