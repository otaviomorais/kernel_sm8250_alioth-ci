+int __sched __folio_lock_killable(struct folio *folio)
+{
+	wait_queue_head_t *q = page_waitqueue(&folio->page);
+	return wait_on_page_bit_common(q, &folio->page, PG_locked, TASK_KILLABLE,
+					EXCLUSIVE);
+}
