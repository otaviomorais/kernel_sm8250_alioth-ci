# Perfil DroidSpaces FULL (one-shot) para o E404.
#
# Este é o perfil final cumulativo: todos os blocos que já foram validados
# individualmente são habilitados em uma única compilação:
#   MEMCG -> CGROUP_PIDS -> CGROUP_DEVICE -> POSIX_MQUEUE -> BINFMT_MISC -> NAT
#
# O upstream E404 já fornece as dependências de namespaces e Netfilter. Elas
# são declaradas aqui para que a configuração final seja explícita e não
# dependa apenas do defconfig base. Não inclui NF_TABLES, MACVLAN/IPVLAN,
# CFS_BANDWIDTH ou extensões opcionais que não foram validadas neste E404.

# Namespaces necessários ao DroidSpaces.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# MEMCG completo.
CONFIG_MEMCG=y
CONFIG_MEMCG_KMEM=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_SLUB_MEMCG_SYSFS_ON=y

# Blocos cumulativos de containers.
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_POSIX_MQUEUE=y
CONFIG_BINFMT_MISC=y

# Rede/NAT explicitamente verificados no perfil final.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_IPV4=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_IP_NF_NAT=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
