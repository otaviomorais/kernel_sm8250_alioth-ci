# nspawn.sh / container profile for Alioth (SM8250)
#
# This is intentionally smaller than droidspaces.config. It enables the
# namespaces and networking primitives used by nspawn.sh, including --net.
# It is not a full LXC resource-control profile: cgroup limits, overlayfs,
# binfmt_misc, seccomp and device policies are not enabled here.
#
# nspawn still needs userspace tools on the device: unshare, mount,
# pivot_root, iproute2 (ip), iptables and ip6tables.

# Namespace and IPC support
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Pseudo-filesystems and cgroup2 mount used inside the container
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y
CONFIG_CGROUPS=y
CONFIG_SYSCTL=y

# IPv4/IPv6 networking and policy routing
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y

# iptables/iptables-legacy backend used by nspawn.sh for NAT and forwarding
CONFIG_NETFILTER=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_IPV4=y
CONFIG_NF_NAT_IPV6=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
