# MEMCG completo + CGROUP_PIDS + CGROUP_DEVICE + bloco 3 POSIX_MQUEUE.
# Base tested: droidspaces-memcg-full-device.config.
# BINFMT_MISC, rede e demais blocos continuam desligados.

CONFIG_USER_NS=y

CONFIG_MEMCG=y
CONFIG_MEMCG_KMEM=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_SLUB_MEMCG_SYSFS_ON=y

CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_POSIX_MQUEUE=y
