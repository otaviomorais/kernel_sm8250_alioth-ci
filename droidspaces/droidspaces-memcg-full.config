# Perfil de teste do MEMCG completo para o E404.
# Mantém o baseline mínimo do DroidSpaces e habilita todas as extensões
# de memória selecionadas para este experimento.
#
# Este perfil NÃO habilita ainda CGROUP_DEVICE/CGROUP_PIDS; o objetivo é
# isolar o comportamento do MEMCG completo antes de reativar o perfil total.

CONFIG_USER_NS=y

CONFIG_MEMCG=y
CONFIG_MEMCG_KMEM=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_SLUB_MEMCG_SYSFS_ON=y
