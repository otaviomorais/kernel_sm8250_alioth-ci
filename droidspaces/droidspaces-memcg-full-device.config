# MEMCG completo + bloco 2 do DroidSpaces: CGROUP_DEVICE.
# Base tested: droidspaces-memcg-full-pids.config.
# Os demais blocos de rede, MQ, BINFMT e VLAN continuam desligados.

CONFIG_USER_NS=y

CONFIG_MEMCG=y
CONFIG_MEMCG_KMEM=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_SLUB_MEMCG_SYSFS_ON=y

CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
