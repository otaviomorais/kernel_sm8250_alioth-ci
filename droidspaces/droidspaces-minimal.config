# Droidspaces MINIMAL para kernel E404 (modo bisect / teste de boot)
# Base E404 + apenas USER_NS. Todo o resto permanece como no upstream.
# Uso: bash droidspaces/apply.sh kernel <defconfig> droidspaces/droidspaces-minimal.config

# User namespaces (requerido pelo Droidspaces; base E404 tem como "is not set")
CONFIG_USER_NS=y
