# MEMCG completo + bloco 1 do DroidSpaces: controlador de PIDs.
# Base: droidspaces-memcg-full.config.
# CGROUP_DEVICE e os demais blocos continuam desligados.

CONFIG_USER_NS=y

CONFIG_MEMCG=y
CONFIG_MEMCG_KMEM=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_SLUB_MEMCG_SYSFS_ON=y

CONFIG_CGROUP_PIDS=y
