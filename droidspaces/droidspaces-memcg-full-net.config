# MEMCG completo + PIDs + Device + POSIX_MQUEUE + BINFMT_MISC + rede NAT.
# Base tested: droidspaces-memcg-full-binfmt.config.
# NF_TABLES, MACVLAN/IPVLAN e firmware-loader extra continuam fora deste bloco.

CONFIG_USER_NS=y

CONFIG_MEMCG=y
CONFIG_MEMCG_KMEM=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_SLUB_MEMCG_SYSFS_ON=y

CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_POSIX_MQUEUE=y
CONFIG_BINFMT_MISC=y

CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
