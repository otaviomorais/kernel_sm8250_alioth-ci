# MEMCG completo + PIDs + Device + POSIX_MQUEUE + bloco 4 BINFMT_MISC.
# Base tested: droidspaces-memcg-full-mq.config.
# Rede, firmware-loader extra, VLAN e scheduler continuam inalterados.

CONFIG_USER_NS=y

CONFIG_MEMCG=y
CONFIG_MEMCG_KMEM=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_SLUB_MEMCG_SYSFS_ON=y

CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_POSIX_MQUEUE=y
CONFIG_BINFMT_MISC=y
