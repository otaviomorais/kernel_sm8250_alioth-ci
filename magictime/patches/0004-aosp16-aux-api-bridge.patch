diff --git a/kernel/sched/sched.h b/kernel/sched/sched.h
index 14b92869b05a20e1e5402f4f94c197816777dd31..93ef019f18be5a3ae5682c6aeabcd6fda05e0c87 100644
--- a/kernel/sched/sched.h
+++ b/kernel/sched/sched.h
@@ -90,6 +90,18 @@ static inline int sched_any_cpu_in_mask(const struct cpumask *src,
 	return nr_cpu_ids;
 }
 
+static inline int sched_first_cpu_in_three_masks(const struct cpumask *a,
+						const struct cpumask *b,
+						const struct cpumask *c)
+{
+	int cpu;
+
+	for_each_cpu(cpu, a)
+		if (cpumask_test_cpu(cpu, b) && cpumask_test_cpu(cpu, c))
+			return cpu;
+	return nr_cpu_ids;
+}
