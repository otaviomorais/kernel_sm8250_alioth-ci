+/*
+ * The AOSP16 vendor isolation entry points were tied to the removed
+ * migrate_tasks() primitive. Keep the calls fail-closed until a compatible
+ * EEVDF task-migration implementation is provided; callers can then fall back
+ * to their normal thermal/hotplug policy instead of marking a CPU isolated
+ * without actually quiescing it.
+ */
+int sched_isolate_count(const cpumask_t *mask, bool include_offline)
+{
+	cpumask_t count_mask;
+
+	if (include_offline) {
+		cpumask_complement(&count_mask, cpu_online_mask);
+		cpumask_or(&count_mask, &count_mask, cpu_isolated_mask);
+		cpumask_and(&count_mask, &count_mask, mask);
+	} else {
+		cpumask_and(&count_mask, mask, cpu_isolated_mask);
+	}
+
+	return cpumask_weight(&count_mask);
+}
+
+int sched_isolate_cpu(int cpu)
+{
+	(void)cpu;
+	return -EOPNOTSUPP;
+}
+
+int sched_unisolate_cpu_unlocked(int cpu)
+{
+	if (cpu < 0 || cpu >= nr_cpu_ids)
+		return -EINVAL;
+	return 0;
+}
+
+int sched_unisolate_cpu(int cpu)
+{
+	return sched_unisolate_cpu_unlocked(cpu);
+}
