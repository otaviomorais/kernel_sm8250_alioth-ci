+/*
+ * AOSP16's PSI implementation tracks runnable, I/O-wait and memstall task
+ * counts, but has no separate IRQ pressure bucket. Keep the scheduler hook
+ * callable while preserving the AOSP16 accounting model.
+ */
+void psi_task_switch(struct task_struct *prev, struct task_struct *next,
+		     bool sleep)
+{
+	(void)sleep;
+
+	if (prev->pid)
+		psi_task_change(prev, TSK_RUNNING, 0);
+	if (next->pid)
+		psi_task_change(next, 0, TSK_RUNNING);
+}
+
+#ifdef CONFIG_IRQ_TIME_ACCOUNTING
+void psi_account_irqtime(struct rq *rq, struct task_struct *curr,
+			 struct task_struct *prev)
+{
+	(void)rq;
+	(void)curr;
+	(void)prev;
+}
