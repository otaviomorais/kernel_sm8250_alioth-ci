-static inline s64 __rq_update_sum(struct rq *rq, bool curr, bool new)
-{
-	if (curr)
-		if (new)
-			return rq->nt_curr_runnable_sum;
-		else
-			return rq->curr_runnable_sum;
-	else
-		if (new)
-			return rq->nt_prev_runnable_sum;
