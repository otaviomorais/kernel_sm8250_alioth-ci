# Experimental EEVDF/CASS profile for the AOSP16 Alioth base.
# This file is consumed only by build-magictime-eeVdf-cass.yml.

CONFIG_SCHED_CASS=y
CONFIG_SCHED_THERMAL_PRESSURE=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_UCLAMP_BUCKETS_COUNT=20

# Optional MagicTime extensions; the core EEVDF/CASS port does not depend on
# these two symbols.
CONFIG_RT_SOFTIRQ_AWARE_SCHED=y
CONFIG_UCLAMP_ASSIST=y

# WALT and its Qualcomm scheduler companions are intentionally disabled.
# Do not silently disable FAIR_GROUP_SCHED/CFS_BANDWIDTH: Android cgroup
# bandwidth semantics are preserved unless a later, explicit profile changes
# them.
# CONFIG_SCHED_WALT is not set
# CONFIG_SCHED_TUNE is not set
# CONFIG_SCHED_CORE_CTL is not set
