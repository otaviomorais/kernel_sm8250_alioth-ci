# ==============================================================================
# Performance, Networking & Memory Optimizations for Poco F3 (Alioth - SM8250)
# ==============================================================================

# TCP BBR Congestion Control (Google BBR for fast Wi-Fi / 5G throughput & low bufferbloat)
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"

# ZSTD Compression support (enables high-ratio ZSTD algorithm for zRAM)
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y

# Kyber I/O Scheduler & blk-mq default (Enables modern blk-mq queueing on UFS 3.1)
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_SCSI_MQ_DEFAULT=y

# Pressure Stall Information (PSI - enables modern Android LMK memory pressure detection)
CONFIG_PSI=y
